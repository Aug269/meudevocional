{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil do usuário autenticado no Meu Devocional",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    },
    "Reflection": {
      "title": "Reflection",
      "description": "Reflexão espiritual pessoal do usuário vinculada ao Lecionário",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "texto": { "type": "string" },
        "titulo": { "type": "string" },
        "modo": { "type": "string" },
        "data": { "type": "string" },
        "referencia": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "texto"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Mensagem da conversa multi-turn com o Assistente Bíblico Gemini",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "role", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "Documento raiz do usuário"
    },
    "/users/{userId}/reflections/{reflectionId}": {
      "schema": "#/entities/Reflection",
      "description": "Coleção de reflexões do diário espiritual sincronizadas"
    },
    "/users/{userId}/chat_messages/{messageId}": {
      "schema": "#/entities/ChatMessage",
      "description": "Histórico de mensagens do chat com Gemini"
    }
  }
}
